# ==========================================
# REMI Enterprise Suite — Environment Template
# ==========================================

# Red Blockchain (Base Mainnet / Testnet)
BASE_RPC_URL=https://mainnet.base.org
REMI_PAYMENT_ADDRESS=0xTuDireccionWalletOficialAqui
MIN_CONFIRMATIONS=3
RPC_TIMEOUT_SECONDS=10

# Base de Datos y Persistencia
MONGO_URI=mongodb://localhost:27017/
REMI_DB_NAME=remi_enterprise_prod

# Configuración de Tokens y Pagos
EXPECTED_TOKEN_ADDRESS=
EXPECTED_TOKEN_DECIMALS=6

# IA y LLM (Ollama / Servicios Externos)
LLM_HOST=http://localhost:11434

# Monitoreo y Errores (Opcional para Producción)
SENTRY_DSN=
