# Environment configuration example for REMI Enterprise Suite (update before use)

# Application port (used by some deployment setups)
PORT=10000

# Optional: MongoDB connection string (for persistent state, auditing, etc.)
# Example: mongodb://user:password@localhost:27017/remi_db
MONGO_URI=your_mongodb_connection_string

# Optional: Web3 provider URI for on-chain verification (Infura, Alchemy, local node)
# Example: https://rpc.base.org or https://mainnet.infura.io/v3/<PROJECT_ID>
WEB3_PROVIDER_URI=your_web3_provider_uri
