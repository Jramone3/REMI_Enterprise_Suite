# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: Remi_core Auditor de Ciberinteligencia y CVEs
# ==============================================================================

# Entorno de Operación (local / production)
AUDITOR_ENV=local
NODE_NAME=ramon-desktop

# Umbral de Alerta Crítica (CVSS Mínimo para notificaciones prioritarias)
CRITICAL_CVSS_THRESHOLD=7.5

# Conexión con la REMI Enterprise Suite (Dashboard en Render)
REMI_SUITE_ENDPOINT=https://remi-enterprise-suite.onrender.com/api/telemetry
REMI_API_KEY=remi_core_secure_internal_key_2026

# Fuentes de Feeds de Seguridad
NIST_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CHECK_INTERVAL_HOURS=6
